# Copy to apps/web/.env.local for development. In production set these in the host's secret manager.
DATABASE_URL=postgres://uday:uday@localhost:5432/uday
# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# HMAC key for searchable hashes: openssl rand -base64 32
LOOKUP_KEY=change-me
# Field encryption keys, 32 bytes base64 each: openssl rand -base64 32. Keep in the key vault. Different keys.
FIELD_KEY_PII=
FIELD_KEY_HEALTH=
FIELD_KEY_SECRET=          # 32 random bytes, base64. Encrypts provider keys saved in the admin module
# Payments: mock (test mode, no money moves) or razorpay
UDAY_ENV=development
GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Razorpay subscription plan ids for facility listings (monthly)
RAZORPAY_PLAN_LISTED=
RAZORPAY_PLAN_FEATURED=
# SMS provider for OTP: log (development only) or the provider the agency implements
SMS_PROVIDER=log
# Development only: fixed OTP so testers can sign in. Never set in production.
OTP_DEV_CODE=123456
# Secret for the scheduler that calls POST /api/cron every minute
CRON_SECRET=change-me
# Optional overrides
# OFFER_WINDOW_MINUTES=30
# GEOFENCE_METRES=150
NOTIFY_LOG=1
# Comma separated origins allowed to call the API from a browser (mobile web preview, Expo dev)
ALLOWED_ORIGINS=
# Encrypted document storage: local (development only) or s3 (agency implements; Indian region bucket)
STORAGE=local
# KYC partner for caregiver identity: mock (test mode only) or the chosen partner
KYC_PROVIDER=mock
# Push notifications: expo to send through the Expo push service; anything else only records
PUSH_PROVIDER=
EXPO_ACCESS_TOKEN=
# RazorpayX account number for caregiver payouts (when GATEWAY=razorpay)
RAZORPAYX_ACCOUNT=
# Intro calls: video room link with {room}, for example https://meet.example.com/{room}
VIDEO_ROOM_URL_TEMPLATE=
# Phone check in: voice flow callback token, and Exotel settings
IVR_TOKEN=
CALL_PROVIDER=log
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_CHECKIN_APP_ID=
# SMS: log, msg91, twilio or auto (India via MSG91, abroad via Twilio)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE=
MSG91_ALERT_TEMPLATE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# WhatsApp Business Cloud API
WHATSAPP_PROVIDER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# AI companion
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# GST invoice
UDAY_GSTIN=
UDAY_LEGAL_NAME=
SITE_URL=https://uday.example      # live domain; used for canonical links, sitemap and share cards
GOOGLE_SITE_VERIFICATION=            # from Google Search Console (HTML tag method), optional
BING_SITE_VERIFICATION=              # from Bing Webmaster Tools, optional

# ── Added in the readiness sprint ──
# Environment: development (fixed OTP allowed) | staging (no fixed OTP; testers use OTP_TEST_ACCOUNTS) | production (all test conveniences refused at startup)
# Named tester and store reviewer accounts, each with its own 6 digit code. Never an operations account.
# OTP_TEST_ACCOUNTS=+919999900001:482913,+919999900002:771204
# Phones called and texted when an SOS or urgent alert is not acknowledged (also editable in Operations, Money and policy)
# OPS_ONCALL_PHONES=+919800000001,+919800000002
# Database pool and TLS. Managed Postgres in production: DATABASE_SSL=require and the provider CA in DATABASE_SSL_CA
# DATABASE_POOL_MAX=20
# DATABASE_SSL=
# DATABASE_SSL_CA=
# File storage: local (development only) or s3 (private bucket; required in production)
# STORAGE=s3
# LOCAL_STORAGE_DIR=./.uploads
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=              # only for a non AWS, S3 compatible store
# S3_FORCE_PATH_STYLE=      # 1 for stores that need path style URLs
# Exotel region host, e.g. api.exotel.com or api.in.exotel.com
# EXOTEL_HOST=
# Note: GATEWAY, CALL_PROVIDER, UDAY_GSTIN and UDAY_LEGAL_NAME above are no longer read from the environment.
# Payment gateway, call provider, GSTIN and legal name are set in Operations, Settings.
