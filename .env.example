# Copy to apps/web/.env.local for development. In production set these in the host's secret manager.
DATABASE_URL=postgres://uday:uday@localhost:5432/uday
# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# HMAC key for searchable hashes: openssl rand -base64 32
LOOKUP_KEY=change-me
# Field encryption keys, 32 bytes base64 each: openssl rand -base64 32. Keep in the key vault. Different keys.
FIELD_KEY_PII=
FIELD_KEY_HEALTH=
# Payments: mock (test mode, no money moves) or razorpay
UDAY_ENV=development
GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# SMS provider for OTP: log (development only) or the provider the agency implements
SMS_PROVIDER=log
# Development only: fixed OTP so testers can sign in. Never set in production.
OTP_DEV_CODE=123456
# Secret for the scheduler that calls POST /api/cron every minute
CRON_SECRET=change-me
# Optional overrides
# OFFER_WINDOW_MINUTES=30
# GEOFENCE_METRES=150
NOTIFY_LOG=1
# Comma separated origins allowed to call the API from a browser (mobile web preview, Expo dev)
ALLOWED_ORIGINS=
# Encrypted document storage: local (development only) or s3 (agency implements; Indian region bucket)
STORAGE=local
# KYC partner for caregiver identity: mock (test mode only) or the chosen partner
KYC_PROVIDER=mock
# Push notifications: expo to send through the Expo push service; anything else only records
PUSH_PROVIDER=
EXPO_ACCESS_TOKEN=
# RazorpayX account number for caregiver payouts (when GATEWAY=razorpay)
RAZORPAYX_ACCOUNT=
