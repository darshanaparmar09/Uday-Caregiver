{
  "expo": {
    "name": "Uday",
    "slug": "uday",
    "scheme": "uday",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#1A1040",
    "splash": {
      "backgroundColor": "#1A1040",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "in.uday.app",
      "supportsTablet": false,
      "infoPlist": {}
    },
    "android": {
      "package": "in.uday.app",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1A1040"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#F5A623"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "SET_BY_AGENCY"
      }
    }
  }
}